# Ollama server URL (local or remote)
OLLAMA_URL=http://localhost:11434

# Ollama model used for intent extraction
INTENT_MODEL=granite3.3:2b

# Ollama model used for natural-language reply generation
REPLY_MODEL=granite3.3:2b

# Optional – enables real-time Google Maps routing
# Leave blank to use the built-in metro graph engine
GOOGLE_MAPS_API_KEY=

# How long to cache route results, in seconds (0 = no cache)
CACHE_TTL_SECONDS=300

# Set to true to enable GET /debug/route diagnostic endpoint
DEBUG=false
